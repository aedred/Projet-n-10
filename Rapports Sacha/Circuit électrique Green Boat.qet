                        <terminal x="-130" y="-30" orientation="w"/>
                        <terminal x="-130" y="0" orientation="w"/>
                        <terminal x="-130" y="30" orientation="w"/>
                        <!-- Bornes Sortie DC (Droite, pas de 10 px) -->
                        <terminal x="130" y="-20" orientation="e"/>
                        <terminal x="130" y="20" orientation="e"/>
                    </description>
                </definition>
            </element>
