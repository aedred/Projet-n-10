            <element name="convertisseur_buck_12v_5v2_6a.elmt">
                <definition type="element" ic="true" link_type="simple" hotspot_x="160" hotspot_y="110" orientation="dyyy" width="320" height="220" version="0.4">
                    <names>
                        <name lang="fr">Convertisseur Buck DC-DC 12V vers 5,2V 6A</name>
                        <name lang="en">DC-DC Buck Step-Down Converter 12V to 5.2V 6A</name>
                    </names>
                    <informations>Convertisseur abaisseur Buck synchrone 9V-36V vers 5,2V fixe 6A (30W) avec borniers, USB-A et Jack DC</informations>
                    <description>
                        <rect ry="4" x="-150" y="-100" antialias="false" style="line-style:normal;line-weight:normal;filling:none;color:black" width="300" height="200" rx="4"/>
                        <line end1="none" end2="none" y1="-75" antialias="false" y2="-75" style="line-style:normal;line-weight:normal;filling:none;color:black" x1="-150" length1="1.5" x2="150" length2="1.5"/>
                        <text x="-94" y="-83" size="8" text="CONVERTISSEUR BUCK DC-DC (5,2V / 6A)"/>
                        <text x="-76" y="-62" size="6" text="Entrée : 9V-36V DC | Sortie fixe : 5,2V (30W)"/>
                        <!-- Zones de branchement Entrée DC (Côté gauche) -->
                        <text x="-144" y="-17" size="6" text="VIN+ (+12V DC) [Bornier]"/>
                        <text x="-144" y="23" size="6" text="VIN- / GND [Bornier]"/>
